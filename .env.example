# Copie este arquivo para ".env" e ajuste se precisar.
# Tudo aqui e opcional - sem .env o sistema funciona com os valores padrao.
# O .env NUNCA vai para o Git (pode ter senha de certificado).

# IA local: "ollama" liga a IA; vazio = IA desligada.
# (A tela IA, no menu da coordenacao, tem prioridade sobre este arquivo.)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Porta e endereco do servidor. 127.0.0.1 = so este computador acessa.
# PORT=3000
# HOST=127.0.0.1

# ---- Acesso por celular/tablet/outros computadores (docs/acesso-remoto.md) ----
# Caminho A (recomendado) - rede privada Tailscale: mantenha HOST=127.0.0.1 e
# TRUST_PROXY=1
#
# Caminho B - so na rede da escola, com HTTPS (certificado):
# HOST=0.0.0.0
# HTTPS_PFX=data/escola.pfx
# HTTPS_PFX_PASSWORD=
#
# Sem HTTPS, o sistema se recusa a abrir para a rede (protecao dos dados).
